# Copy to `.env.local` for local development. Never commit real secrets.

# --- MongoDB (Atlas or local) ---
MONGODB_URI=
# Optional database name (default: rombo)
# MONGODB_DB_NAME=rombo

# --- Rombo backend (server-only) ---
# Target network presets default chain id when ROMBO_DEFAULT_CHAIN_ID is unset:
#   testnet → Base Sepolia (84532)
#   mainnet → Base (8453)
ROMBO_TARGET_NETWORK=testnet

# Optional override for Trading API / LP default chain (must match a slug in lib/rombo/chain-config.ts)
# ROMBO_DEFAULT_CHAIN_ID=84532

# Privy Model 1 (default): agentic_per_agent | user_scoped_signer for Model-style scoped signer
ROMBO_AGENT_WALLET_MODEL=agentic_per_agent

# Privy Dashboard — app credentials (embedded wallets + user APIs)
PRIVY_APP_ID=
PRIVY_APP_SECRET=

# Privy Wallet API — authorization private key for server-controlled agent wallets (keep in KMS in prod)
PRIVY_WALLET_AUTHORIZATION_PRIVATE_KEY=

# Optional — comma-separated Privy policy IDs (first id used where API allows one policy per wallet)
# PRIVY_DEFAULT_POLICY_IDS=

# Uniswap Developers dashboard — Trading + Liquidity APIs
UNISWAP_API_KEY=
# Optional — override Liquidity API host (default https://liquidity.api.uniswap.org)
# UNISWAP_LIQUIDITY_API_BASE=https://liquidity.api.uniswap.org
# Optional — must match across /quote and /swap (default 2.0)
# UNISWAP_UNIVERSAL_ROUTER_VERSION=2.0
# Optional — free-form hint for IL / rebalance rules (Privy policies: PRIVY_DEFAULT_POLICY_IDS)
# ROMBO_LP_REBALANCE_POLICY=

# Indexer / dashboard data — chain-specific Uniswap V3 subgraph (Goldsky / The Graph; see Uniswap docs)
# UNISWAP_V3_SUBGRAPH_URL=https://…

# Optional — protect POST /api/indexer/webhook (send same value in header x-rombo-webhook-secret)
# ROMBO_INDEXER_WEBHOOK_SECRET=

# Optional — protect /api/cron/* (send same value in header x-rombo-cron-secret or `?token=`).
# ROMBO_CRON_SECRET=

# Optional — max age (seconds) a cached pool price may be served (default 60).
# ROMBO_POOL_PRICE_TTL_SECONDS=60

# Optional — JSON-RPC URL for `eth_getTransactionReceipt` (agent receipt poller). Defaults to public Base / Base Sepolia endpoints when unset.
# ROMBO_RPC_URL=https://…

# Agent runtime — set to false to sign quotes only (no Privy broadcast). Omit or any value except `false` executes swaps when configured.
# ROMBO_AGENT_RUNTIME_EXECUTE_SWAPS=false
