# Copy to `.env.local` for local development. Never commit real secrets.

# --- MongoDB (Atlas or local) ---
MONGODB_URI=
# Optional database name (default: rumble)
# MONGODB_DB_NAME=rumble

# --- Rumble backend (server-only) ---
# Target network presets default chain id when RUMBLE_DEFAULT_CHAIN_ID is unset:
#   testnet → Base Sepolia (84532)
#   mainnet → Base (8453)
RUMBLE_TARGET_NETWORK=testnet

# Optional override for Trading API / LP default chain (must match a slug in lib/rumble/chain-config.ts)
# RUMBLE_DEFAULT_CHAIN_ID=84532

# Privy Model 1 (default): agentic_per_agent | user_scoped_signer for Model-style scoped signer
RUMBLE_AGENT_WALLET_MODEL=agentic_per_agent

# Privy Dashboard — app credentials (embedded wallets + user APIs)
PRIVY_APP_ID=
PRIVY_APP_SECRET=

# Privy Wallet API — authorization private key for server-controlled agent wallets (keep in KMS in prod)
PRIVY_WALLET_AUTHORIZATION_PRIVATE_KEY=

# Optional — comma-separated Privy policy IDs (first id used where API allows one policy per wallet)
# PRIVY_DEFAULT_POLICY_IDS=

# Liquidity lab — Reown (WalletConnect) project id (public). RainbowKit / wagmi need this for WalletConnect.
# Dashboard: https://cloud.reown.com — create a project and copy the Project ID.
# Also add your dev origin under Allowed domains (e.g. http://localhost:3000) or you get
# "Origin not found on Allowlist" and 403 when loading WalletConnect config.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Uniswap Developers dashboard — Trading + Liquidity APIs
UNISWAP_API_KEY=
# Optional — override Liquidity API host (default https://liquidity.api.uniswap.org)
# UNISWAP_LIQUIDITY_API_BASE=https://liquidity.api.uniswap.org
# Optional — must match across /quote and /swap (default 2.0)
# UNISWAP_UNIVERSAL_ROUTER_VERSION=2.0
# Optional — free-form hint for IL / rebalance rules (Privy policies: PRIVY_DEFAULT_POLICY_IDS)
# RUMBLE_LP_REBALANCE_POLICY=

# Indexer / dashboard data — Uniswap V3 subgraph (GraphQL POST URL).
# MUST index the same chain as RUMBLE_TARGET_NETWORK (Base Sepolia 84532 vs Base mainnet 8453).
# Using an Ethereum-mainnet subgraph ID will return “pool not found” for Rumble’s Base token addresses.
# The Graph Network gateway — API key in path OR THE_GRAPH_API_KEY + short URL:
#   https://gateway.thegraph.com/api/<YOUR_KEY>/subgraphs/id/<SUBGRAPH_ID>
#   https://gateway.thegraph.com/api/subgraphs/id/<SUBGRAPH_ID>  +  THE_GRAPH_API_KEY=<YOUR_KEY>
# Find a Base deployment in The Graph Explorer (search “Uniswap V3 Base”), not “Uniswap V3 Ethereum”.
# UNISWAP_V3_SUBGRAPH_URL=https://gateway.thegraph.com/api/subgraphs/id/…
# THE_GRAPH_API_KEY=

# Optional — protect POST /api/indexer/webhook (send same value in header x-rumble-webhook-secret)
# RUMBLE_INDEXER_WEBHOOK_SECRET=

# Optional — protect /api/cron/* (send same value in header x-rumble-cron-secret or `?token=`).
# RUMBLE_CRON_SECRET=

# Optional — ETH/USD when subgraph bundle is missing (typical on testnets): fills derivedETH×USD for pool prices + gas anchoring (see lib/onchain/pricing-at.ts).
# RUMBLE_ETH_USD_REF=

# Optional — max age (seconds) a cached pool price may be served (default 60).
# RUMBLE_POOL_PRICE_TTL_SECONDS=60

# Optional — JSON-RPC URL (receipt poller, Chainlink `eth_call` for spot prices). Defaults to public Base / Base Sepolia when unset.
# RUMBLE_RPC_URL=https://…

# Optional — set to `false` to disable Chainlink spot USD (ETH/USD, BTC/USD) on Base / Base Sepolia. Default: enabled.
# RUMBLE_CHAINLINK_SPOT_ENABLED=

# Agent runtime — set to false to sign quotes only (no Privy broadcast). Omit or any value except `false` executes swaps when configured.
# RUMBLE_AGENT_RUNTIME_EXECUTE_SWAPS=false

# OpenAI — optional; when set, each agent tick may ask the model which price box to use (still enforced by guardrails + box definitions).
# OPENAI_API_KEY=
# RUMBLE_OPENAI_MODEL=gpt-4o-mini
# Set to false to force rule-based box selection only (no LLM calls).
# RUMBLE_LLM_AGENT_ENABLED=false

# Agent ticks — production uses Vercel cron `/api/cron/agents-tick`. During `npm run dev`, ticks run when
# your dashboard is open and the agent is **running** (POST `/api/agents/[id]/tick` with your session).
